# KSP Crime AI — Backend environment configuration
# Copy to `.env` and adjust for your deployment. NEVER commit real secrets.

# --- Database ---
# SQLite (default, dev):
# DATABASE_URL=sqlite:///./ksp_crime_ai.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/ksp_crime_ai
#
# IMPORTANT (persistence): on ephemeral hosts (e.g. Catalyst AppSail, where the
# app dir is read-only and SQLite falls back to /tmp) the SQLite file is WIPED on
# every restart/redeploy, and each instance keeps its own copy — so registered
# FIRs appear to vanish. For production, point DATABASE_URL at PostgreSQL: it is
# persistent and shared by all instances. All analytics SQL is dialect-portable
# (see src/database/dialect.py), so no code changes are needed to switch.
# Check the live mode any time via GET /api/system/info.

# --- Seeding ---
# The demo dataset is auto-seeded ONLY when the database is empty.
# Set to false on a persistent/production database so real data is never
# re-seeded after a restart. Seed once, then disable.
KSP_AUTOSEED=true

# --- Authentication ---
# Change this to a long random string in production.
KSP_SECRET_KEY=change-me-to-a-long-random-secret
# Salt used for password hashing.
KSP_PW_SALT=change-me-too
# Token validity in seconds (default 8 hours).
KSP_TOKEN_TTL=28800
# Set to false ONLY for local demos to bypass login.
KSP_AUTH_REQUIRED=true

# --- API / CORS ---
# Comma-separated list of allowed frontend origins.
KSP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Expose generated SQL in responses (debugging only — keep false in prod).
KSP_EXPOSE_SQL=false
